{
  "name": "trianglify",
  "version": "4.2.0",
  "description": "Trianglify is a javascript library for generating colorful triangle meshes that can be used as SVG images and CSS backgrounds.",
  "main": "dist/trianglify.js",
  "module": "dist/trianglify.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/trianglify.esm.js",
      "require": "./dist/trianglify.js"
    }
  },
  "scripts": {
    "lint": "eslint src/**/*.js",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "publish-beta": "npm run build && npm publish --tag next",
    "ci": "npm run lint && npm run build",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "chroma-js": "^2.4.2",
    "delaunator": "^5.0.0"
  },
  "peerDependencies": {
    "canvas": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "directories": {
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/qrohlf/trianglify.git"
  },
  "keywords": [
    "svg",
    "visualization",
    "pattern",
    "lowpoly"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.node.test.js"],
    "extensionsToTreatAsEsm": [".js"],
    "preset": "default"
  },
  "author": "Quinn Rohlf <qr@qrohlf.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/qrohlf/trianglify/issues"
  },
  "homepage": "https://github.com/qrohlf/trianglify",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "rollup": "^4.0.0"
  }
}
